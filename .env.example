# Anthropic — the LLM component
ANTHROPIC_API_KEY=

# Alpaca — paper trading execution (get free paper keys at alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# LLM model selection
ICT_AGENT_MODEL=claude-sonnet-4-6

# Optional: alternative providers (leave blank to skip)
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Watchlist — comma-separated symbols (default is XAUUSD only to keep runs fast)
ICT_WATCHLIST=XAUUSD

# Prompt-chaining gate controls
ICT_GATE_MAX_RETRIES=2
ICT_GATE_HARD_STOP=true

# Instrument the video-grounded prompt sets were written against
ICT_PROMPT_SET_NATIVE_INSTRUMENT=NQ

# Local DB and session storage
ICT_AGENT_DB=ict_agent.db
