  "cards": [
    {
      "dot": "cyan",
      "title": "Staged Loop",
      "items": [
        "Each LLM call receives accumulated context from prior stages",
        "Tools are stage-scoped \u00e2\u20ac\u201d only relevant plugins are mounted per stage",
        "The adapter abstracts the provider; swap Claude for DeepSeek without touching the loop"
      ]
    },
    {
      "dot": "orange",
      "title": "Gate Feedback Loop",
      "items": [
        "Hard gates (HTF, LTF, Confluence) inject the parse error back into the prompt",
        "Soft gates (Timing) let the chain continue with a degraded flag",
        "After GATE_MAX_RETRIES (default 2), the chain hard-stops with a no_setup narrative"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable Evidence",
      "items": [
        "Every tool call, result, and gate outcome is appended to session_log.jsonl",
        "The SQLite store holds episodic analyses for exact-match recall",
        "Semantic embeddings enable get_similar_setups() across past market conditions"
      ]
    }
