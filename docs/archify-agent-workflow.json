  "cards": [
    {
      "dot": "cyan",
      "title": "Four-Stage Pipeline",
      "items": [
        "HTF Bias \u00e2\u2020\u2019 structure + liquidity + PD array on hourly candles",
        "Timing \u00e2\u2020\u2019 kill zones, recent context, economic calendar",
        "LTF Entry \u00e2\u2020\u2019 FVG / order blocks on 15m candles after sweep",
        "Risk & Execution \u00e2\u2020\u2019 confluence bar check, place or watch"
      ]
    },
    {
      "dot": "orange",
      "title": "Hard Gate Checks",
      "items": [
        "Each stage emits structured output validated by a pure-Python gate",
        "On failure: error is injected back into the prompt and the stage retries",
        "GATE_MAX_RETRIES defaults to 2; hard stop emits disciplined no_setup narrative",
        "Timing gate is soft \u00e2\u20ac\u201d chain continues but marks stage as degraded"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence Trail",
      "items": [
        "Every gate result, tool call, and retry is appended to session_log.jsonl",
        "Memory store holds episodic analyses + semantic MAG embeddings for similarity search",
        "Per-stage metrics exportable to CSV for backtest comparison and review"
      ]
    }
