  "cards": [
    {
      "dot": "cyan",
      "title": "Data Fallback Chain",
      "items": [
        "Primary: Binance direct REST for OHLCV",
        "Fallback: Yahoo Finance via yfinance when Binance is unavailable",
        "Cached per-session in RunContext._candle_cache to avoid duplicate fetches"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory-Augmented Generation",
      "items": [
        "Episodic: SQLite stores every analysis_log + trades row for exact recall",
        "Semantic: MAG embeddings of narratives via OpenRouter text-embedding-3-small",
        "Before Stage 1 runs, get_similar_setups() fetches K semantically closest past analyses"
      ]
    },
    {
      "dot": "amber",
      "title": "Observability Trail",
      "items": [
        "SessionLog appends every tool call, result, and gate decision to JSONL",
        "Memory/metrics.py computes per-stage scores (gate pass rate, confluence hits)",
        "Exported to CSV for backtest comparison and strategy evaluation over time"
      ]
    }
  ]
